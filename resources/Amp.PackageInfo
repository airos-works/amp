name amp
version 0.3.5~alpha-10
architecture x86_64
summary "Music player for local libraries, styled after iTunes 8"
description "Amp plays MP3, MP4/AAC, FLAC, WAV and OGG files from local folders. It reads tags with TagLib, caches album and artist artwork from embedded pictures, folder art, MusicBrainz/Cover Art Archive, TheAudioDB and Discogs, offers album, artist and playlist browsing, and writes playlists and albums to a MiniDisc through a NetMD recorder."
packager "Amp contributors"
vendor "Amp"
urls { "https://github.com/jmgasper/amp" }
copyrights { "2026 Amp contributors" "2013-2025 Niels Lohmann" "2024 Fonticons, Inc." }
licenses { "MIT" "SIL OFL 1.1" "CC BY 4.0" }
provides {
    amp = 0.3.5~alpha
    app:Amp = 0.3.5~alpha
}
requires {
    haiku >= r1~beta6
    lib:libcurl
    lib:libsqlite3
    lib:libtag >= 2
}
post-install-scripts {
    "boot/post-install/amp.sh"
}
